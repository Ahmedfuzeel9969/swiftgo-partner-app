rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin: custom claim `admin: true` is the primary path (Phase 2B).
    // Email bootstrap remains only while settings/security.adminBootstrapEnabled != false.
    function isClaimAdmin() {
      return isSignedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isBootstrapAdminEmail() {
      return isSignedIn()
        && 'email' in request.auth.token
        && 'email_verified' in request.auth.token
        && request.auth.token.email == 'fuzail1158@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdminBootstrapEnabled() {
      return !exists(/databases/$(database)/documents/settings/security)
        || get(/databases/$(database)/documents/settings/security)
             .data.get('adminBootstrapEnabled', true) == true;
    }

    function isSuperAdmin() {
      return isClaimAdmin()
        || (isAdminBootstrapEnabled() && isBootstrapAdminEmail());
    }

    function partnerAccountStatus(uid) {
      return get(/databases/$(database)/documents/partners/$(uid))
        .data.get('accountStatus', 'active');
    }

    function partnerIsActiveDriver(uid) {
      return !exists(/databases/$(database)/documents/partners/$(uid))
        || (
          partnerAccountStatus(uid) != 'blocked'
          && partnerAccountStatus(uid) != 'suspended'
        );
    }

    // Explicit allowlist for ordinary partner self-updates (Phase 2A — no denylist-only).
    // Financial fields (walletBalance, totalEarnings, totalRidesCompleted, etc.) are
    // excluded because they are not in this list.
    function isPartnerSelfSafeUpdate(partnerId) {
      return request.auth.uid == partnerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'currentVehicleId', 'name', 'displayName', 'email', 'updatedAt', 'role'
             ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || request.resource.data.role in ['owner', 'driver']
        );
    }

    // Phase 2B: drivers/{id} self-update allowlist (no role/wallet/approval/earnings).
    function isDriverProfileSafeUpdate(driverId) {
      return request.auth.uid == driverId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'displayName', 'name', 'phone', 'photoUrl',
               'currentVehicleId', 'updatedAt'
             ]);
    }

    // Allowed booking lifecycle states (audit: enum was unconstrained).
    function isValidStatus(status) {
      return status in ['scheduled', 'current', 'completed', 'cancelled'];
    }

    // Booking payload shape shared by create + update.
    // Note: .size() on a non-string or >= on a non-number raises an
    // evaluation error, which Firestore treats as a deny — so these
    // checks also enforce field types.
    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'service', 'pickup', 'destination', 'status', 'fare'])
        && data['service'].size() > 0 && data['service'].size() <= 40
        && data.pickup.size() <= 300
        && data.destination.size() <= 500
        && isValidStatus(data.status)
        && data.fare >= 0;
    }

    function isValidDriverApplication(data) {
      return data.keys().hasAll([
          'userId', 'fullName', 'cnic', 'licenseNumber', 'vehicleType',
          'status', 'cnicFrontUrl', 'cnicBackUrl', 'licenseImageUrl', 'selfieUrl',
          'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.fullName.size() > 0 && data.fullName.size() <= 120
        && data.cnic.size() > 0 && data.cnic.size() <= 20
        && data.licenseNumber.size() <= 40
        && data.vehicleType.size() > 0 && data.vehicleType.size() <= 40
        && data.status == 'pending'
        && data.cnicFrontUrl.size() <= 2000
        && data.cnicBackUrl.size() <= 2000
        && data.licenseImageUrl.size() <= 2000
        && data.selfieUrl.size() <= 2000;
    }

    // Phase 37: driver wallet recharge requests.
    function isValidRechargeRequest(data) {
      return data.keys().hasAll([
          'driverId', 'driverName', 'method', 'amount', 'tid', 'status', 'createdAt'
        ])
        && data.driverId == request.auth.uid
        && data.driverName.size() > 0 && data.driverName.size() <= 120
        && data.method in ['jazzcash', 'easypaisa']
        && data.amount > 0 && data.amount <= 500000
        && data.tid.size() > 0 && data.tid.size() <= 80
        && data.status == 'pending';
    }

    // ── users/{uid} ──
    // Phase 2B: customer display wallet only. Canonical driver wallet is partners.walletBalance.
    // Clients (including Super Admin client SDK) may never change walletBalance.
    // Trusted Admin SDK settlement writes partners only — never this field for drivers.
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.walletBalance == 0
        && request.resource.data.keys().hasAll(['displayName', 'email', 'walletBalance']);

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['walletBalance']);

      allow delete: if false;
    }

    // ── bookings/{id} ──
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidBooking(request.resource.data);

      // Owner may update, but cannot reassign the booking to another user
      // and the new payload must still pass shape + status-enum validation.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && isValidBooking(request.resource.data);

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── rides/{id} ── (Phase 16: live ride requests)
    // Create: owner only, must start in 'searching_driver' with full payload.
    // Update: owner may cancel while searching, or complete an accepted ride.
    // Driver-side accepted/declined transitions belong to a backend/admin.
    function isValidRide(data) {
      return data.keys().hasAll([
          'userId', 'pickupLocation', 'dropoffLocation', 'vehicleType',
          'distanceKm', 'timeMins', 'farePkr', 'status', 'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.pickupLocation.keys().hasAll(['lat', 'lng', 'address'])
        && data.dropoffLocation.keys().hasAll(['lat', 'lng', 'address'])
        && data.pickupLocation.address.size() <= 500
        && data.dropoffLocation.address.size() <= 500
        && data.vehicleType.size() > 0 && data.vehicleType.size() <= 40
        && data.distanceKm >= 0
        && data.timeMins >= 0
        && data.farePkr >= 0
        && data.status == 'searching_driver'
        && (!('promoCode' in data) || (
          data.promoCode is string
          && data.promoCode.size() >= 1
          && data.promoCode.size() <= 32
        ))
        && (!('discountAmount' in data) || data.discountAmount >= 0)
        && (!('originalFare' in data) || data.originalFare >= data.farePkr)
        && (!('paymentMethod' in data) || data.paymentMethod in
             ['cash', 'easypaisa', 'jazzcash', 'business']);
    }

    match /rides/{rideId} {
      // Customer watches own ride. Assigned driver/owner may read.
      // Open searching rides are readable only by invited candidates (not global list).
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
        || (
          resource.data.status == 'searching_driver'
          && exists(
            /databases/$(database)/documents/ride_candidates/$(rideId + '_' + request.auth.uid)
          )
        )
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
        || (
          resource.data.status == 'searching_driver'
          && exists(
            /databases/$(database)/documents/ride_candidates/$(rideId + '_' + request.auth.uid)
          )
        )
      );

      allow create: if isSignedIn()
        && isValidRide(request.resource.data);

      allow update: if isSignedIn()
        && (
          (
            // Customer may cancel while searching only — never complete (Phase 2A / P1-002).
            resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status == 'searching_driver'
            && request.resource.data.status == 'cancelled_by_user'
          )
          ||
          (
            // Phase 32: assigned driver advances accepted → arrived → in_progress only.
            // Blocked/suspended drivers cannot progress (Phase 2B / T07).
            resource.data.driverId == request.auth.uid
            && partnerIsActiveDriver(request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && (
              (resource.data.status == 'accepted'
                && request.resource.data.status == 'arrived')
              ||
              (resource.data.status == 'arrived'
                && request.resource.data.status == 'in_progress')
            )
          )
          ||
          (
            // Phase 42: customer rates a completed ride (one time).
            resource.data.userId == request.auth.uid
            && resource.data.status == 'completed'
            && !('customerRating' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['customerRating', 'ratedAt'])
            && request.resource.data.customerRating >= 1
            && request.resource.data.customerRating <= 5
          )
        );

      allow delete: if false;
    }

    // Phase 2A: private offers — driver↔customer only; never another driver's offer.
    match /ride_offers/{offerId} {
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || resource.data.customerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || resource.data.customerId == request.auth.uid
      );
      // Clients must not create/mutate offers — trusted CF / Admin SDK only.
      allow create, update, delete: if false;
    }

    // Phase 2A: candidate invitations — written by matching CF only.
    match /ride_candidates/{candidateId} {
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.userId
             == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // Concurrent booking counter — server maintained.
    match /booking_slots/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── ride_requests/{id} ── Phase 2B: legacy archive — read-only; canonical bookings are rides/.
    match /ride_requests/{requestId} {
      allow get, list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // ── drivers/{driverId} ── Phase 2B: allowlisted self-updates only
    match /drivers/{driverId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || request.auth.uid == driverId
      );

      allow create: if isSignedIn()
        && request.auth.uid == driverId
        && !request.resource.data.keys().hasAny([
          'walletBalance', 'totalEarnings', 'commissionPercent', 'role',
          'accountStatus', 'approvalStatus', 'suspended', 'verified',
          'admin', 'isAdmin'
        ]);

      allow update: if isSignedIn() && isDriverProfileSafeUpdate(driverId);

      allow update: if isSuperAdmin();

      allow delete: if false;
    }

    // ── vehicles/{id} ── Phase 2B: privacy + blocked-driver online gate + no public PIN query
    match /vehicles/{vehicleId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'plate'])
        // Prefer pinHash; legacy plaintext pin allowed only for owner-created docs during migration.
        && (
          ('pinHash' in request.resource.data && request.resource.data.pinHash is string)
          || ('pin' in request.resource.data && request.resource.data.pin is string)
        );

      // Not world-readable: owner, assigned driver, or Super Admin only.
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.ownerId == request.auth.uid
        || resource.data.driverId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.ownerId == request.auth.uid
        || resource.data.driverId == request.auth.uid
      );

      // Owner manages own vehicles (ownerId immutable). May set pinHash; should not broaden privacy.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['walletBalance', 'earnings', 'commissionPercent']);

      // Driver claim / go online — blocked/suspended partners denied (T07 / P1-013).
      allow update: if isSignedIn()
        && partnerIsActiveDriver(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['driverId', 'status', 'driverName'])
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.status == 'online'
        && (resource.data.status != 'online' || resource.data.driverId == request.auth.uid);

      allow update: if isSignedIn()
        && partnerIsActiveDriver(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activeRideId', 'status'])
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.status in ['online', 'in_ride'];

      allow update: if isSignedIn()
        && partnerIsActiveDriver(request.auth.uid)
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'location', 'locationUpdatedAt', 'driverName', 'status',
               'geoCell', 'hotspotId', 'locationGridCell'
             ])
        && request.resource.data.location.keys().hasAll(['lat', 'lng'])
        && request.resource.data.location.lat >= -90
        && request.resource.data.location.lat <= 90
        && request.resource.data.location.lng >= -180
        && request.resource.data.location.lng <= 180
        && request.resource.data.status in ['online', 'in_ride'];

      allow update: if isSignedIn()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'offline';

      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'driverId', 'driverName', 'previousDriverId',
               'previousDriverName', 'status'
             ]);

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // PIN attempt counters — self-read only; writes via Admin SDK / CF.
    match /pin_attempts/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Admin registry metadata — Super Admin read; writes Admin SDK only.
    match /admin_registry/{uid} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── partners/{uid} ── (Phase 25: driver ↔ vehicle assignment)
    // Phase 2A: financial fields locked; self-update is allowlist-only.
    match /partners/{partnerId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || request.auth.uid == partnerId
      );

      // Partners may create owner/driver profiles only — never self-assign admin_driver.
      // Financial aggregates must start at zero if present.
      allow create: if isSignedIn()
        && request.auth.uid == partnerId
        && (
          !request.resource.data.keys().hasAny(['accountStatus'])
          || request.resource.data.accountStatus == 'active'
        )
        && (
          !request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role in ['owner', 'driver']
        )
        && (
          !('walletBalance' in request.resource.data)
          || request.resource.data.walletBalance == 0
        )
        && (
          !('totalEarnings' in request.resource.data)
          || request.resource.data.totalEarnings == 0
        )
        && (
          !('totalRidesCompleted' in request.resource.data)
          || request.resource.data.totalRidesCompleted == 0
        );

      // Self-update: explicit safe-field allowlist only (P1-001 / P1-003).
      allow update: if isSignedIn() && isPartnerSelfSafeUpdate(partnerId);

      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['accountStatus'])
        && request.resource.data.accountStatus in ['active', 'blocked', 'suspended'];

      // Phase 43: Super Admin God Mode — full partner write for drive takeover / restore.
      allow update: if isSuperAdmin();

      // Phase 37: Super Admin may credit driver wallet on recharge approval.
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance'])
        && request.resource.data.walletBalance >= resource.data.walletBalance;

      // Phase 42: customer rating aggregate after a completed ride (non-financial).
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['customerRatingSum', 'customerRatingCount'])
        && request.resource.data.customerRatingCount
             == resource.data.get('customerRatingCount', 0) + 1
        && request.resource.data.customerRatingSum
             >= resource.data.get('customerRatingSum', 0) + 1
        && request.resource.data.customerRatingSum
             <= resource.data.get('customerRatingSum', 0) + 5;

      allow delete: if false;
    }

    // ── ledger_transactions/{id} ── Phase 2A immutable settlement ledger (Admin SDK only).
    match /ledger_transactions/{txId} {
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || resource.data.customerId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || resource.data.customerId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // ── audit_logs/{id} ── Phase 2A trusted audit (Admin SDK only).
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── settings/{document} ──
    // Phase 30: dynamic pricing (settings/pricing). Signed-in apps may read;
    // only Super Admin may write.
    match /settings/{document} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // ── driver_applications/{id} ──
    match /driver_applications/{appId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidDriverApplication(request.resource.data);

      allow update, delete: if false;
    }

    // ── rechargeRequests/{requestId} ── (Phase 37: wallet top-up approvals)
    match /rechargeRequests/{requestId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() || resource.data.driverId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() || resource.data.driverId == request.auth.uid
      );

      allow create: if isSignedIn()
        && isValidRechargeRequest(request.resource.data);

      allow update: if isSuperAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'approvedAt']);

      allow delete: if false;
    }

    // ── promoCodes/{code} ── (Phase 42: discount codes)
    match /promoCodes/{codeId} {
      allow read: if isSignedIn();

      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasAll(['code', 'type', 'value', 'active', 'createdAt'])
        && request.resource.data.code == codeId
        && request.resource.data.code.size() >= 1
        && request.resource.data.code.size() <= 32
        && request.resource.data.type in ['percent', 'fixed']
        && request.resource.data.value > 0
        && request.resource.data.active is bool
        && (!('usedCount' in request.resource.data) || request.resource.data.usedCount >= 0)
        && (!('maxUses' in request.resource.data) || request.resource.data.maxUses >= 0);

      allow update: if isSuperAdmin()
        || (
          isSignedIn()
          && resource.data.active == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
          && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1
          && (!('maxUses' in resource.data)
              || resource.data.maxUses <= 0
              || request.resource.data.usedCount <= resource.data.maxUses)
        );

      allow delete: if isSuperAdmin();
    }

    // Everything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
