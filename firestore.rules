rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isSignedIn() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/account_deletion_requests/$(request.auth.uid))
        || (get(/databases/$(database)/documents/account_deletion_requests/$(request.auth.uid)).data.get('accessBlocked', false) != true
          && !(get(/databases/$(database)/documents/account_deletion_requests/$(request.auth.uid)).data.get('status', '')
            in ['pending', 'pending_review', 'reviewed', 'erasure_in_progress', 'completed'])));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Revocation takes effect against already-issued tokens. Email/profile is not authority.
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.get('admin', false) == true
        && request.auth.token.get('adminRole', '') == 'super_admin'
        && request.auth.token.get('adminVersion', null) is int
        && exists(/databases/$(database)/documents/admin_registry/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_registry/$(request.auth.uid)).data.admin == true
        && get(/databases/$(database)/documents/admin_registry/$(request.auth.uid)).data.role == 'super_admin'
        && get(/databases/$(database)/documents/admin_registry/$(request.auth.uid)).data.version == request.auth.token.adminVersion;
    }

    function partnerIsActiveDriver(uid) {
      return exists(/databases/$(database)/documents/partners/$(uid))
        && get(/databases/$(database)/documents/partners/$(uid)).data.get('accountStatus', '') == 'active'
        && get(/databases/$(database)/documents/partners/$(uid)).data.get('role', '') in ['driver', 'owner']
        && get(/databases/$(database)/documents/partners/$(uid)).data.get('driverApprovalStatus', '') == 'approved';
    }

    // Explicit allowlist for ordinary partner self-updates (Phase 2A — no denylist-only).
    // Financial fields and `role` are excluded (role locked after create; legacy
    // admin_driver may demote to driver only).
    function isPartnerSelfSafeUpdate(partnerId) {
      return request.auth.uid == partnerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'name', 'displayName', 'email', 'updatedAt', 'role'
             ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || (
            resource.data.get('role', '') == 'admin_driver'
            && request.resource.data.role == 'driver'
          )
        );
    }

    // Phase 2B: drivers/{id} self-update allowlist (no role/wallet/approval/earnings).
    function isDriverProfileSafeUpdate(driverId) {
      return request.auth.uid == driverId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'displayName', 'name', 'phone', 'photoUrl',
               'updatedAt'
             ]);
    }

    function isValidVehicleGeoCell(cell) {
      return cell is string && cell.size() >= 3;
    }

    // Phase 1 live-location: bounded session id (non-empty, max 64, safe charset).
    function isValidTrackingSessionId(id) {
      return id is string
        && id.size() >= 3
        && id.size() <= 64
        && id.matches('^[A-Za-z0-9_-]+$');
    }

    /**
     * Session-start immutability + location.sessionId consistency.
     * A) trackingSessionId create/change ⇒ trackingSessionStartedAt must also change
     *    and equal request.time.
     * B) trackingSessionId unchanged ⇒ trackingSessionStartedAt unchanged.
     * C) trackingSessionStartedAt may not change independently.
     * E) location.sessionId must equal trackingSessionId.
     */
    /** Driver vehicle writes must stamp locationUpdatedAt with authoritative request.time. */
    function vehicleLocationUpdatedAtOk() {
      return request.resource.data.keys().hasAll(['locationUpdatedAt'])
        && request.resource.data.locationUpdatedAt is timestamp
        && request.resource.data.locationUpdatedAt == request.time;
    }

    function vehicleTrackingSessionFieldsOk() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let sessionChanged = keys.hasAny(['trackingSessionId']);
      let startChanged = keys.hasAny(['trackingSessionStartedAt']);
      let sessionMutationOk =
        (sessionChanged
          && startChanged
          && request.resource.data.trackingSessionStartedAt == request.time)
        || (!sessionChanged && !startChanged);
      return sessionMutationOk
        && isValidTrackingSessionId(request.resource.data.trackingSessionId)
        && request.resource.data.location.keys().hasAll(['lat', 'lng', 'sessionId'])
        && request.resource.data.location.sessionId is string
        && request.resource.data.location.sessionId == request.resource.data.trackingSessionId
        && isValidTrackingSessionId(request.resource.data.location.sessionId);
    }

    // Driver ONLINE_READY — single combined geo + online write (writeOnlineReadyVehicle).
    function isDriverVehicleOnlineReadyUpdate() {
      return isSignedIn()
        && partnerIsActiveDriver(request.auth.uid)
        && resource.data.get('driverId', '') == request.auth.uid
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.get('activeRideId', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'driverId', 'status', 'driverName', 'location', 'locationUpdatedAt',
          'locationGridCell', 'geoCell', 'hotspotId', 'activeRideId',
          'trackingSessionId', 'trackingSessionStartedAt'
        ])
        && request.resource.data.status == 'online'
        && request.resource.data.driverName is string
        && request.resource.data.location.keys().hasAll(['lat', 'lng'])
        && request.resource.data.location.lat >= -90
        && request.resource.data.location.lat <= 90
        && request.resource.data.location.lng >= -180
        && request.resource.data.location.lng <= 180
        && vehicleLocationUpdatedAtOk()
        && request.resource.data.locationGridCell is string
        && isValidVehicleGeoCell(request.resource.data.geoCell)
        && (
          !('hotspotId' in request.resource.data)
          || request.resource.data.hotspotId == null
          || request.resource.data.hotspotId is string
        )
        && (
          !('activeRideId' in request.resource.data)
          || request.resource.data.activeRideId == null
        )
        && vehicleTrackingSessionFieldsOk();
    }

    function isValidDriverApplication(data) {
      return data.keys().hasAll([
          'userId', 'fullName', 'cnic', 'licenseNumber', 'vehicleType',
          'status', 'cnicFrontUrl', 'cnicBackUrl', 'licenseImageUrl', 'selfieUrl',
          'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.fullName.size() > 0 && data.fullName.size() <= 120
        && data.cnic.size() > 0 && data.cnic.size() <= 20
        && data.licenseNumber.size() <= 40
        && data.vehicleType.size() > 0 && data.vehicleType.size() <= 40
        && data.status == 'pending'
        && data.cnicFrontUrl.size() <= 2000
        && data.cnicBackUrl.size() <= 2000
        && data.licenseImageUrl.size() <= 2000
        && data.selfieUrl.size() <= 2000;
    }

    // Phase 37: driver wallet recharge requests.
    function isValidRechargeRequest(data) {
      return data.keys().hasAll([
          'driverId', 'driverName', 'method', 'amount', 'tid', 'status', 'createdAt'
        ])
        && data.keys().hasOnly(['driverId', 'driverName', 'method', 'amount', 'tid', 'status', 'createdAt'])
        && data.driverId == request.auth.uid
        && data.driverName.size() > 0 && data.driverName.size() <= 120
        && data.method in ['jazzcash', 'easypaisa']
        && data.amount is int && data.amount > 0 && data.amount <= 500000
        && data.tid.matches('^[A-Za-z0-9-]{1,80}$')
        && data.createdAt == request.time
        && data.status == 'pending';
    }

    // ── users/{uid} ──
    // Phase 2B: customer display wallet only. Canonical driver wallet is partners.walletBalance.
    // Clients (including Super Admin client SDK) may never change walletBalance.
    // Trusted Admin SDK settlement writes partners only — never this field for drivers.
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();

      // Clients may seed a profile, but never assign super_admin / privileged roles.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['legalHold', 'personalDataErased', 'retentionPolicyVersion', 'deletionRequested', 'deletionRequestedAt'])
        && request.resource.data.walletBalance == 0
        && request.resource.data.keys().hasAll(['displayName', 'email', 'walletBalance'])
        && (
          !request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role in ['customer', 'user']
        );

      // role + walletBalance are Admin-SDK / trusted-server only.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['walletBalance', 'role', 'legalHold', 'personalDataErased', 'retentionPolicyVersion', 'deletionRequested', 'deletionRequestedAt']);

      allow delete: if false;
    }

    // ── bookings/{id} ── legacy archive; canonical booking records are rides/.
    match /bookings/{bookingId} {
      allow get, list: if isSignedIn() && (
        isSuperAdmin() || resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // ── rides/{id} ── (Phase 16: live ride requests)
    // Create: owner only, must start in 'searching_driver' with full payload.
    // Update: owner may cancel while searching, or complete an accepted ride.
    // Driver-side accepted/declined transitions belong to a backend/admin.
    function isValidRide(data) {
      return data.keys().hasAll([
          'userId', 'pickupLocation', 'dropoffLocation', 'vehicleType',
          'distanceKm', 'timeMins', 'farePkr', 'status', 'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.pickupLocation.keys().hasAll(['lat', 'lng', 'address'])
        && data.dropoffLocation.keys().hasAll(['lat', 'lng', 'address'])
        && data.pickupLocation.address.size() <= 500
        && data.dropoffLocation.address.size() <= 500
        && data.vehicleType.size() > 0 && data.vehicleType.size() <= 40
        && data.distanceKm >= 0
        && data.timeMins >= 0
        && data.farePkr >= 0
        && data.status == 'searching_driver'
        && (!('promoCode' in data) || (
          data.promoCode is string
          && data.promoCode.size() >= 1
          && data.promoCode.size() <= 32
        ))
        && (!('discountAmount' in data) || data.discountAmount >= 0)
        && (!('originalFare' in data) || data.originalFare >= data.farePkr)
        && (!('paymentMethod' in data) || data.paymentMethod in
             ['cash', 'easypaisa', 'jazzcash', 'business']);
    }

    match /rides/{rideId} {
      // Customer watches own ride. Assigned driver/owner may read.
      // Open searching rides are readable only by invited candidates (not global list).
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
        || (
          resource.data.status == 'searching_driver'
          && exists(
            /databases/$(database)/documents/ride_candidates/$(rideId + '_' + request.auth.uid)
          )
        )
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
        || (
          resource.data.status == 'searching_driver'
          && exists(
            /databases/$(database)/documents/ride_candidates/$(rideId + '_' + request.auth.uid)
          )
        )
      );

      // Phase 2A (2026-07-29): client ride create denied — trusted createCustomerBooking only.
      allow create: if false;

      allow update: if isSignedIn()
        && (
          (
            // Customer may cancel while searching only — never complete (Phase 2A / P1-002).
            resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status == 'searching_driver'
            && request.resource.data.status == 'cancelled_by_user'
          )
          ||
          (
            // Phase 32: assigned driver advances accepted → arrived → in_progress only.
            // Blocked/suspended drivers cannot progress (Phase 2B / T07).
            resource.data.driverId == request.auth.uid
            && partnerIsActiveDriver(request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && (
              (resource.data.status == 'accepted'
                && request.resource.data.status == 'arrived')
              ||
              (resource.data.status == 'arrived'
                && request.resource.data.status == 'in_progress')
            )
          )
          ||
          (
            // Phase 42: customer rates a completed ride (one time).
            resource.data.userId == request.auth.uid
            && resource.data.status == 'completed'
            && !('customerRating' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['customerRating', 'ratedAt'])
            && request.resource.data.customerRating >= 1
            && request.resource.data.customerRating <= 5
          )
        );

      allow delete: if false;
    }

    // Customer moving GPS: private to current participants, only during an
    // active assignment. Never written directly by either browser.
    match /rides/{rideId}/customerLocations/{assignmentId} {
      allow get: if isSignedIn()
        && exists(/databases/$(database)/documents/rides/$(rideId))
        && get(/databases/$(database)/documents/rides/$(rideId)).data.status in ['accepted', 'arrived', 'in_progress']
        && get(/databases/$(database)/documents/rides/$(rideId)).data.assignmentSessionToken == assignmentId
        && (get(/databases/$(database)/documents/rides/$(rideId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/rides/$(rideId)).data.driverId == request.auth.uid);
      allow list, create, update, delete: if false;
    }

    // Active-ride live-location budget is enforced on the server, not just in UI.
    // Idle dispatch/ONLINE_READY remains governed by its separate policy.
    function activeRideLocationBudgetFor(rideId) {
      let config = exists(/databases/$(database)/documents/settings/dispatch)
        ? get(/databases/$(database)/documents/settings/dispatch).data : {};
      let raw = config.get('firebaseFallbackWriteSeconds', 4);
      let interval = raw is int && raw >= 2 && raw <= 60 ? raw : 4;
      let rawGrace = config.get('p2pFallbackAfterSeconds', 12);
      let grace = rawGrace is int && rawGrace >= 5 && rawGrace <= 60 ? rawGrace : 12;
      let ride = get(/databases/$(database)/documents/rides/$(rideId)).data;
      let assignedAt = ride.get('assignedAt', null);
      let previous = resource.data.get('locationUpdatedAt', null);
      return config.get('firebaseLocationFallbackEnabled', true) == true
        && ride.driverId == request.auth.uid
        && ride.status in ['accepted', 'arrived', 'in_progress']
        && (!(assignedAt is timestamp) || request.time >= assignedAt + duration.value(grace, 's'))
        && (!(previous is timestamp) || request.time >= previous + duration.value(interval, 's'));
    }

    function activeRideLocationBudgetOk() {
      let rideId = resource.data.get('activeRideId', null);
      return rideId == null || (rideId is string && rideId.size() > 0 && activeRideLocationBudgetFor(rideId));
    }

    // Phase 2A: private offers — driver↔customer only; never another driver's offer.
    match /ride_offers/{offerId} {
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || resource.data.customerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || resource.data.customerId == request.auth.uid
      );
      // Clients must not create/mutate offers — trusted CF / Admin SDK only.
      allow create, update, delete: if false;
    }

    // Phase 2A: candidate invitations — written by matching CF only.
    match /ride_candidates/{candidateId} {
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.userId
             == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // Concurrent booking counter — server maintained.
    match /booking_slots/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Phase 1 viewer presence lease — writes via Admin/CF only; no coordinates.
    // Doc id: {rideId}_{customerUid}
    // Driver get allowed only while assigned on a trackable execution ride.
    match /rideViewerPresence/{presenceId} {
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.customerId == request.auth.uid
        || (
          resource.data.rideId is string
          && exists(/databases/$(database)/documents/rides/$(resource.data.rideId))
          && get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.driverId
               == request.auth.uid
          && get(/databases/$(database)/documents/rides/$(resource.data.rideId)).data.status
               in ['accepted', 'arrived', 'in_progress']
        )
      );
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Phase 3 P2P signaling — Admin/CF writes only; get for current assigned peers.
    // Doc id: {rideId}. SDP readable only by participants; list denied.
    match /ridePeerSessions/{rideId} {
      function currentPeerRide() {
        return get(/databases/$(database)/documents/rides/$(rideId)).data;
      }
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || (
          exists(/databases/$(database)/documents/rides/$(rideId))
          && currentPeerRide().status in ['accepted', 'arrived', 'in_progress']
          && (currentPeerRide().userId == request.auth.uid || currentPeerRide().driverId == request.auth.uid)
          // A listener may attach before the driver creates the first offer.
          && (!exists(/databases/$(database)/documents/ridePeerSessions/$(rideId)) || (
            resource.data.customerId == currentPeerRide().userId
            && resource.data.driverId == currentPeerRide().driverId
            && resource.data.vehicleId == currentPeerRide().vehicleId
            && resource.data.assignmentId == currentPeerRide().assignmentSessionToken
          ))
        )
      );
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Server-validated distance telemetry; no direct client reads/writes.
    match /rideBreadcrumbTelemetry/{rideId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    // Per-ride location delivery reports — Admin read only; writes via Cloud Functions.
    match /rideLocationReports/{rideId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── ride_requests/{id} ── Phase 2B: legacy archive — read-only; canonical bookings are rides/.
    match /ride_requests/{requestId} {
      allow get, list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // ── drivers/{driverId} ── Phase 2B: allowlisted self-updates only
    match /drivers/{driverId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || request.auth.uid == driverId
      );

      allow create: if isOwner(driverId)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'name', 'phone', 'email', 'photoUrl', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() && isDriverProfileSafeUpdate(driverId);

      allow delete: if false;
    }

    // ── vehicles/{id} ── Phase 2B: privacy + blocked-driver online gate + no public PIN query
    match /vehicles/{vehicleId} {
      allow create: if false; // Trusted createFleetVehicle only.

      // Not world-readable: owner, assigned driver, active-ride customer, or Super Admin.
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.ownerId == request.auth.uid
        || resource.data.driverId == request.auth.uid
        || (
          !resource.data.keys().hasAny(['pin', 'pinHash'])
          && resource.data.activeRideId is string
          && exists(/databases/$(database)/documents/rides/$(resource.data.activeRideId))
          && get(/databases/$(database)/documents/rides/$(resource.data.activeRideId)).data.status in ['accepted', 'arrived', 'in_progress']
          && get(/databases/$(database)/documents/rides/$(resource.data.activeRideId)).data.userId
               == request.auth.uid
        )
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.ownerId == request.auth.uid
        || resource.data.driverId == request.auth.uid
      );

      // Owner manages own vehicles (ownerId immutable). May set pinHash; should not broaden privacy.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.get('activeRideId', null) == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['model', 'plate', 'updatedAt']);

      // Driver ONLINE_READY — combined location + geo + online status in one write.
      allow update: if isDriverVehicleOnlineReadyUpdate();

      allow update: if isSignedIn()
        && partnerIsActiveDriver(request.auth.uid)
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'location', 'locationUpdatedAt', 'driverName', 'status',
               'geoCell', 'hotspotId', 'locationGridCell',
               'trackingSessionId', 'trackingSessionStartedAt'
             ])
        && request.resource.data.location.keys().hasAll(['lat', 'lng'])
        && request.resource.data.location.lat >= -90
        && request.resource.data.location.lat <= 90
        && request.resource.data.location.lng >= -180
        && request.resource.data.location.lng <= 180
        && request.resource.data.status in ['online', 'in_ride']
        && (resource.data.get('activeRideId', null) == null || request.resource.data.status == 'in_ride')
        && activeRideLocationBudgetOk()
        && vehicleLocationUpdatedAtOk()
        && vehicleTrackingSessionFieldsOk();

      allow update: if isSignedIn()
        && resource.data.driverId == request.auth.uid
        && resource.data.get('activeRideId', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'offline';

      // Assignment/release/deletion are never client writes, even for an admin.
      allow delete: if false;
    }

    // PIN attempt counters — self-read only; writes via Admin SDK / CF.
    match /pin_attempts/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Admin registry metadata — Super Admin read; writes Admin SDK only.
    match /admin_registry/{uid} {
      allow get: if isOwner(uid) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── partners/{uid} ── (Phase 25: driver ↔ vehicle assignment)
    // Phase 2A: financial fields locked; self-update is allowlist-only.
    match /partners/{partnerId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || request.auth.uid == partnerId
      );

      // Partners may create driver profiles only — owner role is Admin-SDK via approveOwnerAccess.
      // Financial aggregates must start at zero if present.
      allow create: if isSignedIn()
        && request.auth.uid == partnerId
        && request.resource.data.keys().hasOnly(['uid', 'role', 'accountStatus', 'driverApprovalStatus', 'name', 'displayName', 'email', 'phone', 'photoUrl', 'currentVehicleId', 'walletBalance', 'totalEarnings', 'totalRidesCompleted', 'createdAt', 'updatedAt'])
        && request.resource.data.get('driverApprovalStatus', 'pending') == 'pending'
        && request.resource.data.get('currentVehicleId', null) == null
        && (
          !request.resource.data.keys().hasAny(['accountStatus'])
          || request.resource.data.accountStatus == 'active'
        )
        && (
          !request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role == 'driver'
        )
        && (
          !('walletBalance' in request.resource.data)
          || request.resource.data.walletBalance == 0
        )
        && (
          !('totalEarnings' in request.resource.data)
          || request.resource.data.totalEarnings == 0
        )
        && (
          !('totalRidesCompleted' in request.resource.data)
          || request.resource.data.totalRidesCompleted == 0
        );

      // Self-update: explicit safe-field allowlist only (P1-001 / P1-003).
      allow update: if isSignedIn() && isPartnerSelfSafeUpdate(partnerId);

      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['accountStatus'])
        && request.resource.data.accountStatus in ['active', 'blocked', 'suspended'];

      // Phase 42 / Phase 2A (2026-07-29): partner rating aggregates are Admin SDK / CF only.
      // Client increments were forgeable (any signed-in user). Ride doc rating remains client-OK.

      allow delete: if false;
    }

    // ── ledger_transactions/{id} ── Phase 2A immutable settlement ledger (Admin SDK only).
    match /ledger_transactions/{txId} {
      allow get: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || resource.data.customerId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isSuperAdmin()
        || resource.data.driverId == request.auth.uid
        || resource.data.customerId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // ── audit_logs/{id} ── Phase 2A trusted audit (Admin SDK only).
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── vehicle_pins/{vehicleId} ── Owner-only permanent PIN display (survives pin-link strip).
    match /vehicle_pins/{vehicleId} {
      allow read, write: if false;
    }

    // ── account_deletion_requests/{uid} ── Phase 4E (Admin SDK writes; owner may read own)
    match /account_deletion_requests/{userId} {
      // A still-valid old token may inspect its own request but cannot access app data.
      allow get: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /retention_events/{eventId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /retention_runs/{runId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /identity_erasure_jobs/{jobId} {
      allow get, list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── support_reports/{id} ── Phase 4E complaints (Admin SDK writes)
    match /support_reports/{reportId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ── ops_metrics/{id} ── Phase 4F monitoring snapshots (Admin SDK writes)
    match /ops_metrics/{metricId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── settings/{document} ──
    // Phase 30: dynamic pricing (settings/pricing). Signed-in apps may read;
    // write: claim admin OR users/{uid}.role == super_admin OR bootstrap email.
    match /settings/{document} {
      allow read: if isSignedIn() && (document != 'dataRetention' || isSuperAdmin());
      allow write: if isSuperAdmin() && !(document in ['pricing', 'security', 'dataRetention']);
    }

    // ── driver_applications/{id} ──
    match /driver_applications/{appId} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ── owner_applications/{uid} ── (Task 3B: fleet-owner approval queue; Admin SDK writes only)
    match /owner_applications/{appId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || (request.auth.uid == appId && resource.data.uid == request.auth.uid)
      );

      allow create, update, delete: if false;
    }

    // ── rechargeRequests/{requestId} ── (Phase 37: wallet top-up approvals)
    match /rechargeRequests/{requestId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() || resource.data.driverId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() || resource.data.driverId == request.auth.uid
      );

      allow create: if isSignedIn()
        && isValidRechargeRequest(request.resource.data);

      allow update: if false; // Approval credits wallet and ledger in one server transaction.

      allow delete: if false;
    }

    // ── promoCodes/{code} ── (Phase 42: discount codes)
    match /promoCodes/{codeId} {
      allow read: if isSignedIn();

      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasAll(['code', 'type', 'value', 'active', 'createdAt'])
        && request.resource.data.code == codeId
        && request.resource.data.code.size() >= 1
        && request.resource.data.code.size() <= 32
        && request.resource.data.type in ['percent', 'fixed']
        && request.resource.data.value > 0
        && request.resource.data.active is bool
        && request.resource.data.get('usedCount', 0) == 0
        && (request.resource.data.type != 'percent' || request.resource.data.value <= 100)
        && (!('maxUses' in request.resource.data) || request.resource.data.maxUses >= 0);

      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'value', 'type', 'maxUses', 'expiresAt', 'updatedAt'])
        && request.resource.data.type in ['percent', 'fixed']
        && request.resource.data.value > 0
        && (request.resource.data.type != 'percent' || request.resource.data.value <= 100);

      allow delete: if isSuperAdmin();
    }

    // Everything else: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
