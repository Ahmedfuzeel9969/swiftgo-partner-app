{
  "name": "ride-app",
  "version": "1.0.0",
  "description": "Live app: **https://swiftgo-ride-app.web.app**",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:phase2c",
    "test:phase1": "firebase emulators:exec --only firestore,storage --project demo-swiftgo-phase1 \"node tests/phase1-emulator-contract.mjs\"",
    "test:phase2a": "firebase emulators:exec --only firestore,storage --project demo-swiftgo-phase1 \"node tests/phase2a-run-all.mjs\"",
    "test:phase2b": "firebase emulators:exec --only firestore,storage --project demo-swiftgo-phase1 \"node tests/phase2b-run-all.mjs\"",
    "test:phase2c": "firebase emulators:exec --only firestore,storage,auth --project demo-swiftgo-phase1 \"node tests/phase2c-run-all.mjs\"",
    "test:phase2d": "firebase emulators:exec --only auth,firestore,storage,functions --project demo-swiftgo-phase1 \"node tests/phase2d-functions-runtime.mjs\"",
    "test:phase2e": "npm run build:hosting && firebase emulators:exec --only auth,firestore,storage,functions,hosting --project demo-swiftgo-phase1 \"node tests/phase2e-four-app-browser.mjs\"",
    "test:phase3a": "node tests/phase3a-inventory-scan.mjs && firebase emulators:exec --only auth,firestore,storage,functions --project demo-swiftgo-phase1 \"node tests/phase3a-per-ride-measurement.mjs\"",
    "test:phase3b": "firebase emulators:exec --only auth,firestore,storage,functions --project demo-swiftgo-phase1 \"node tests/phase3b-geo-matching.mjs\"",
    "test:phase4a-ui": "npm run build:hosting && node tests/phase4a-ui-responsive-audit.mjs",
    "test:phase4b-a11y": "npm run build:hosting && node tests/phase4b-a11y-verify.mjs",
    "test:phase4d": "npm run build:hosting && node tests/phase4d-responsive-verify.mjs",
    "test:phase4e": "npm run build:hosting && node tests/phase4e-trust-verify.mjs",
    "test:phase4e-deletion": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/phase4e-account-deletion.mjs\"",
    "test:phase4f-storage": "firebase emulators:exec --only storage --project demo-swiftgo-phase1 \"node tests/phase4f-storage-rules.mjs\"",
    "test:phase4f-ops": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/phase4f-ops-verify.mjs\"",
    "test:phase4g": "node tests/phase4g-android-verify.mjs",
    "test:phase4h": "node tests/phase4h-pilot-readiness.mjs",
    "mobile:sync": "node tools/phase4g-sync-mobile.mjs",
    "mobile:harden": "node tools/phase4g-apply-android-hardening.mjs",
    "android:sync": "npm run build:hosting && node tools/phase4g-sync-mobile.mjs",
    "android:aab:customer": "npm run android:sync && cd mobile/customer && npx cap sync android && cd android && gradlew.bat bundleRelease",
    "android:aab:partner": "npm run android:sync && cd mobile/partner && npx cap sync android && cd android && gradlew.bat bundleRelease",
    "android:aab:owner": "npm run android:sync && cd mobile/owner && npx cap sync android && cd android && gradlew.bat bundleRelease",
    "build:hosting": "node tools/build-hosting.mjs",
    "test:hosting-startup-health": "node tools/build-hosting.mjs && node tools/hosting-startup-health.mjs",
    "test:hosting-startup-health:live": "node tools/hosting-startup-health.mjs --url https://swiftgo-ride-app.web.app",
    "test:audit": "node tests/audit.test.mjs",
    "test:i18n": "node tests/i18n-purity-scan.mjs",
    "test:ci-preview": "node tests/ci-preview-gate.mjs",
    "test:dispatch-e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/dispatch-booking-radar-e2e.mjs\"",
    "test:dispatch-readiness": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/dispatch-readiness-race.mjs\"",
    "test:dispatch-online-ready-rules": "firebase emulators:exec --only firestore --project demo-swiftgo-phase1 \"node tests/dispatch-online-ready-rules.mjs\"",
    "test:driver-active-ride-reconcile": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/driver-active-ride-reconcile.mjs\"",
    "test:driver-active-ride-pointer-heal": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/driver-active-ride-pointer-heal.mjs\"",
    "test:driver-fresh-location-online": "node tests/driver-fresh-location-online.mjs",
    "test:live-location-foundation": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/live-location-foundation.mjs\"",
    "test:viewer-presence-lifecycle": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/viewer-presence-lifecycle.mjs\"",
    "test:checkpoint-policy": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/checkpoint-policy.mjs\"",
    "test:p2p-webrtc": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/p2p-webrtc.mjs\"",
    "test:p2p-turn-credentials": "node tests/p2p-turn-credentials.mjs",
    "test:background-location-upload": "node tests/background-location-upload.mjs",
    "test:customer-p2p-background": "node tests/customer-p2p-background.mjs",
    "test:customer-location-report-counters": "node tests/customer-location-report-counters.mjs",
    "test:customer-map-follow-driver": "node tests/customer-map-follow-driver.mjs",
    "test:customer-marker-motion": "node tests/customer-marker-motion-continuity.mjs",
    "test:live-location-terminal-reliability": "node tests/live-location-terminal-reliability.mjs",
    "test:two-leg-route-blank-gap": "node tests/stage8-tranche2-blank-gap-ride-switch.mjs",
    "test:stage8-tranche3-idle": "node tests/stage8-tranche3-idle-index.mjs",
    "test:stage8-tranche4-owner-admin": "node tests/stage8-tranche4-owner-admin-hosting.mjs",
    "test:road-routing": "node tests/road-routing.mjs",
    "test:road-snapping": "node tests/road-snapping.mjs",
    "test:breadcrumb-telemetry-rules": "firebase emulators:exec --only firestore --project demo-swiftgo-phase1 \"node tests/breadcrumb-telemetry-rules.mjs\"",
    "test:breadcrumb-batching": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/breadcrumb-batching.mjs\"",
    "test:breadcrumb-hardening": "firebase emulators:exec --only auth,firestore,functions --project demo-swiftgo-phase1 \"node tests/breadcrumb-hardening.mjs\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "apexcharts": "^6.5.0",
    "react-apexcharts": "^2.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.49.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0"
  }
}
