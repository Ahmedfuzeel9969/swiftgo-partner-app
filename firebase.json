{
  "hosting": {
    "public": "hosting-dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known/**",
      "**/node_modules/**"
    ],
    "predeploy": [
      "node tools/hosting-deploy-integrity.mjs",
      "node tools/build-hosting.mjs",
      "node tools/hosting-startup-health.mjs --no-write",
      "node tools/hosting-deploy-integrity.mjs --verify-build"
    ],
    "redirects": [
      {
        "source": "/driver",
        "destination": "/partner/",
        "type": 301
      },
      {
        "source": "/driver/**",
        "destination": "/partner/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/partner",
        "destination": "/partner/index.html"
      },
      {
        "source": "/partner/**",
        "destination": "/partner/index.html"
      },
      {
        "source": "/owner",
        "destination": "/owner/index.html"
      },
      {
        "source": "/owner/**",
        "destination": "/owner/index.html"
      },
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      },
      {
        "source": "/customer",
        "destination": "/customer/index.html"
      },
      {
        "source": "/customer/**",
        "destination": "/customer/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|mjs|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "auth": {
      "port": 9099
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
